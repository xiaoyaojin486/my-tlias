# ============================================================
# 环境变量模板
# 使用方法: 复制本文件为 .env, 然后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略, 不会被提交到仓库
# ============================================================

# -------------------- MySQL --------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tlias
DB_USERNAME=root
DB_PASSWORD=your_password_here

# -------------------- JWT 签名密钥 --------------------
# 必须是 Base64 编码的随机字节串, 且解码后长度 >= 256 bit(32 字节),
# 否则应用启动时会直接抛 WeakKeyException 失败(这是有意为之, 防止弱密钥上线)
#
# 生成方式(任选一种):
#   openssl   : openssl rand -base64 32
#   Linux/Mac : head -c 32 /dev/urandom | base64
#   Java      : byte[] b = new byte[32]; new SecureRandom().nextBytes(b);
#               System.out.println(Base64.getEncoder().encodeToString(b));
#
# 注意: 必须用密码学安全的随机源(SecureRandom / /dev/urandom),
#       不要用 Math.random() 或自己手敲的字符串
JWT_SIGN_KEY=replace_with_your_generated_key

# 令牌有效期(毫秒), 不配置则默认 12 小时
JWT_EXPIRE=43200000

# -------------------- 阿里云 OSS --------------------
# 注意: 这两个变量由 OSS SDK 通过 EnvironmentVariableCredentialsProvider
# 直接从「操作系统环境变量」读取, 写在 .env 里不会被 Spring 注入到系统环境中,
# 必须配置为真正的系统环境变量才行, 例如:
#   Windows PowerShell: $env:OSS_ACCESS_KEY_ID="your_id"
#   IDEA: Run/Debug Configurations -> Environment variables
#   不配置也不影响启动, 只是文件上传功能不可用
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
